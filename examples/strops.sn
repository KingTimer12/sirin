use sirin.io

s = "Hello, World"

println(s.len())
println(s.to_upper())
println(s.to_lower())
println(s.slice(0, 5))
println(s.index_of("World"))
println(s.contains("World"))
println(s.starts_with("Hello"))
println(s.ends_with("World"))
println(s.replace("World", "Sirin"))

line = "  GET /users/1 HTTP/1.1  "
println(line.trim())

parts = line.trim().split(" ")
println(parts.get(0))
println(parts.get(1))
println(parts.get(2))

n = "42".to_int()
println(n + 8)

body = "{\"name\": \"Julius\", \"age\": 24}"
user: { name: str, age: int } = body.to_object()
println(user.name)
println(user.age)
