use sirin.io

fn fetch(id: int) -> Try[int?] {
    if (id < 0) { return Err("invalid id") }
    if (id == 0) { return Ok(None) }
    return Ok(Some(id * 10))
}

fn main() {
    if Ok(o) = fetch(5) {
        if Some(v) = o {
            println(v)
        } else {
            println("ok but empty")
        }
    }

    if Ok(o) = fetch(0) {
        println(o.unwrap_or(-1))
    }

    if Err(e) = fetch(-1) {
        println(e)
    }

    a: Option[int] = Some(7)
    b: Try[int] = Ok(8)
    println(a.unwrap())
    println(b.unwrap())
}
