// HTTP/1.1 library written in pure Sirin.
//
// Aggregator: re-exports every submodule. Consumers write `use http`
// and get access to `serve`, `Request`, `Response`, parsing and serialization.
//
//   sirin/http/types.sn      Request / Response types
//   sirin/http/parse.sn      request parsing (line, headers, body)
//   sirin/http/serialize.sn  response serialization
//   sirin/http/transport.sn  sending / receiving over TcpStream
//   sirin/http/server.sn     handler, accept_loop, serve

use http.types
use http.parse
use http.serialize
use http.transport
use http.server
