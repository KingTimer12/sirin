use sirin.net
use types
use parse
use serialize

// ── send / receive ─────────────────────────────────────────────────────────────

fn send_response(conn: TcpStream, res: Response) {
    raw = serialize_response(res)
    conn.write(raw)
}

fn read_request(conn: TcpStream) -> Request! {
    raw = conn.read()
    if (raw.len() == 0) {
        return Err("connection closed")
    }
    return parse_request(raw)
}
