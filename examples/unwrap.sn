use sirin.io

fn find(id: int) -> str? {
    if (id == 1) { return Some("Julius") }
    return None
}

fn parse(s: str) -> int! {
    if (s.len() == 0) { return Err("empty") }
    return Ok(s.to_int())
}

fn main() {
    name = find(1)
    println(name.unwrap())

    missing = find(2)
    println(missing.unwrap_or("anon"))
    println(missing.is_none())
    println(name.is_some())

    r = parse("42")
    println(r.unwrap())
    println(r.is_ok())

    bad = parse("")
    println(bad.unwrap_or(0))
    println(bad.is_err())
}
