use sirin.io

fn achar(id: int) -> str? {
    if (id == 1) { return Some("Julius") }
    return None
}

fn parse(s: str) -> int! {
    if (s.len() == 0) { return Err("vazio") }
    return Ok(s.to_int())
}

fn main() {
    nome = achar(1)
    println(nome.unwrap())

    faltante = achar(2)
    println(faltante.unwrap_or("anon"))
    println(faltante.is_none())
    println(nome.is_some())

    r = parse("42")
    println(r.unwrap())
    println(r.is_ok())

    bad = parse("")
    println(bad.unwrap_or(0))
    println(bad.is_err())
}
