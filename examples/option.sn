use sirin.io

fn find(id: int) -> str? {
    if (id == 1) {
        return Some("Julius")
    }
    return None
}

fn main() {
    name = find(1)
    if Some(n) = name {
        println(n)
    } else {
        println("nothing")
    }

    if Some(n) = find(2) {
        println(n)
    } else {
        println("id 2 not found")
    }

    age: int? = Some(24)
    if Some(i) = age {
        println(i)
    }

    empty: int? = None
    if Some(i) = empty {
        println(i)
    } else {
        println("empty")
    }
}
