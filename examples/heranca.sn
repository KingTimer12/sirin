interface Late {
    fn latir() -> str
}

class Animal {
    nome: str

    init(n: str) {
        nome = n
    }

    fn descrever() -> str => nome
}

class Cachorro extends Animal implements Late {
    raca: str

    init(n: str, r: str) {
        nome = n
        raca = r
    }

    fn latir() -> str => self.nome
}

a: Animal = Animal("Rex")
c: Cachorro = Cachorro("Bolt", "Labrador")
